# Stripe
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Get from: https://dashboard.stripe.com/webhooks
# Local dev: run `stripe listen --forward-to localhost:3000/api/webhook`
# and use the whsec_... value printed by the CLI
STRIPE_WEBHOOK_SECRET=whsec_...

# Jotform
# Get from: Jotform → Your Form → Settings → Integrations → Webhook
JOTFORM_WEBHOOK_URL=https://www.jotform.com/server.php?action=...

# Resend — for booking request emails
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...

# Where booking requests get sent (your inbox)
BOOKING_NOTIFY_EMAIL=you@yourdomain.com

# The "from" address — must be on a domain verified in Resend
# Example: bookings@bydesign.ai. While testing you can use onboarding@resend.dev
BOOKING_FROM_EMAIL=bookings@yourdomain.com

# Site URL — no trailing slash
# Local: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
