# ─── Site ────────────────────────────────────────────────────────────────
# No trailing slash. Local: http://localhost:3000 · Production: https://aixdesign.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Email (Resend) ──────────────────────────────────────────────────────
# https://resend.com/api-keys — sender domain must be verified in Resend.
RESEND_API_KEY=re_...
# Display name + verified sender, e.g. "AI by Design <hello@aixdesign.dev>"
RESEND_FROM_EMAIL=AI by Design <hello@aixdesign.dev>
# Where new-lead / intake notifications are sent
LEAD_NOTIFY_EMAIL=terrysc107@gmail.com

# ─── Database (Supabase) ─────────────────────────────────────────────────
# Project Settings → API. Service-role key is server-only — never expose it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── AI (OpenAI) — intake review + content engine ────────────────────────
OPENAI_API_KEY=sk-...
# Optional model override (defaults in code)
OPENAI_MODEL=gpt-4o

# ─── Lead magnet ─────────────────────────────────────────────────────────
# Public URL of the guide PDF served on lead capture
GUIDE_PDF_URL=https://aixdesign.dev/guide.pdf

# ─── Calendly webhook + cron auth ────────────────────────────────────────
# Calendly → Webhooks signing key (verifies booking webhook payloads)
CALENDLY_WEBHOOK_SIGNING_KEY=
# Shared secret protecting /api/cron/* routes (set same value in Vercel cron)
CRON_SECRET=

# ─── Analytics (optional — site no-ops cleanly if unset) ─────────────────
# GA4 Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Postiz (social auto-posting) ────────────────────────────────────────
# Base URL of your Postiz instance API, e.g. https://postiz.yourdomain.com
POSTIZ_API_URL=
# Postiz API key (Settings → Public API)
POSTIZ_API_KEY=

# ─── Content engine (LinkedIn medical lane) ──────────────────────────────
# No new vars — reuses OpenAI (generate), Supabase (bda_content_queue),
# Postiz (publish), Resend (drafts-ready email), and CRON_SECRET (crons).
# Local CLI workflow (load env with --env-file):
#   npx tsx --env-file=.env.local scripts/generate-content.ts --count 6   # → drafts
#   npx tsx --env-file=.env.local scripts/content-review.ts --list        # review/approve
#   npx tsx --env-file=.env.local scripts/content-review.ts --approve <id>
#   npx tsx --env-file=.env.local scripts/schedule-content.ts --live      # → LinkedIn via Postiz
# Automated: cron/content-generate (weekly top-up) + cron/content-publish (daily).
